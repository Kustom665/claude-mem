# ---------------------------------------------------------------------------
# Supabase
# Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key. Safe to expose to the browser — RLS protects the data.
# Newer Supabase projects call this the publishable key; either variable works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used for Stripe bookkeeping columns and the automation endpoint.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx

# Recurring monthly price charged to the agency for ONE active client seat.
# Create it in Stripe: Product -> Add price -> Recurring -> Monthly.
STRIPE_SEAT_PRICE_ID=price_xxx

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# or the Stripe dashboard webhook endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used for auth redirects and Stripe return URLs.
# On Vercel this is filled in automatically from VERCEL_PROJECT_PRODUCTION_URL
# when left unset, but setting it explicitly is more reliable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the existing n8n / Twilio backend sends as `x-automation-secret`
# when it reads client config or records a lead.
# Generate with: openssl rand -hex 32
AUTOMATION_API_SECRET=
