# ScrapMap configuration
# Every value here has a working default. No API keys are required anywhere:
# all third-party data comes from keyless, free, public endpoints.

# --- Server ---
PORT=4000
NODE_ENV=development

# Where the SQLite database and uploaded photos live.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Secret used to sign session tokens. A random one is generated and persisted
# on first boot if you leave this unset, which is fine for local development.
# Set an explicit value in production so sessions survive restarts.
SESSION_SECRET=

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Free third-party APIs (all keyless) ---

# OpenStreetMap Nominatim requires a descriptive User-Agent identifying your app.
# Nominatim's usage policy asks for a contact address; please put your own here.
# https://operations.osmfoundation.org/policies/nominatim/
OSM_USER_AGENT=ScrapMap/1.0 (https://github.com/your-org/scrapmap; contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
STOOQ_BASE_URL=https://stooq.com/q/l/

# Set to 1 to disable all outbound third-party calls and serve only cached or
# built-in fallback data. Useful for offline development and CI.
OFFLINE_MODE=0

# --- Web (Vite) ---
# Only needed if the API is not on http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
