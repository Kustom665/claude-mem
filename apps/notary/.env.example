# PostgreSQL is the committed default: the app is deployed on Vercel, whose
# serverless filesystem is ephemeral and read-only, so SQLite cannot persist
# there. Prisma 7 reads this from prisma.config.ts, and src/lib/db.ts picks the
# driver adapter from the URL scheme at runtime.
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# On Supabase use the pooler URI from the dashboard's Connect panel, not the
# db.<ref>.supabase.co direct host: that host is IPv6-only and Vercel cannot
# reach it. Through the pooler the username carries the project ref, as in
# notary_app.<project-ref>. See the Supabase section of the README.

# Local SQLite instead — set the URL below, change the provider in
# prisma/schema.prisma back to "sqlite", and restore the archived migrations
# from prisma/migrations.sqlite. A relative file: path resolves against the
# project root (apps/notary/dev.db), not against prisma/.
# DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start without this in production.
SESSION_SECRET="dev-only-insecure-secret-change-me-before-deploying-anywhere-real"
