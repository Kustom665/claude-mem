# Local development uses SQLite. This path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — run `npm run db:use-postgres` to switch the schema
# provider, then point this at your database:
# DATABASE_URL="postgresql://user:password@host:5432/notarydesk?schema=public"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start without this in production.
SESSION_SECRET="dev-only-insecure-secret-change-me-before-deploying-anywhere-real"
